# Yosys ASIC Synthesis Script for Apex-L1Cache Controller
# Target: Nangate 45nm Open Cell Library (Typical Corner)

read_verilog -sv rtl/tag_array.v
read_verilog -sv rtl/plru_replacement.v
read_verilog -sv rtl/mshr_table.v
read_verilog -sv rtl/writeback_buffer.v
read_verilog -sv rtl/axi4_master_interface.v
read_verilog -sv rtl/apex_cache_controller.v

hierarchy -check -top apex_cache_controller
synth -top apex_cache_controller -flatten

dfflibmap -liberty synth/nangate45.lib
abc -liberty synth/nangate45.lib

clean
stat -liberty synth/nangate45.lib
write_verilog -noattr synth/apex_cache_controller_nangate45_netlist.v
